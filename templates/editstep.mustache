{{!
    @template mod_examcheck/editstep

    Header for the dedicated "Edit step" page: just a back link to the
    management page. The step_form is rendered by the page below this.

    Context variables required for this template:
    * backurl - URL of the Manage steps page

    Example context (json):
    {
        "backurl": "#"
    }
}}
<div class="mod_examcheck-editstep mb-3">
    <a class="btn btn-link p-0" href="{{backurl}}">&larr; {{#str}}backtomanagesteps, mod_examcheck{{/str}}</a>
</div>
