{{!
    @template 'mod_examcheck/confirm_modal';

    Template purpose and description.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
        "user_picture": "<img>...</img>",
        "user_fullname": "Jane Doe",
        "scan_field_name": "User id (internal)",
        "scan_value": "6",
        "roster_link": "https://tbd.example.org"
    }
}}

{{< core/modal }}
    {{$classes}} {{classes}} modal-fullscreen-sm-down {{/classes}}
    {{$title}}{{#str}} confirm_step, mod_examcheck, {{step_name}} {{/str}}{{/title}}
    {{$body}}
        {{> mod_examcheck/confirm_modal/user_info }}
    {{/body}}
    {{$footer}}
        <button type="button" class="btn btn-secondary flex-grow-1 flex-sm-grow-0" data-action="hide">{{#str}} cancel {{/str}}</button>
        <button type="button" class="btn btn-primary flex-grow-1 flex-sm-grow-0" data-action="confirm">{{#str}} confirm {{/str}}</button>
    {{/footer}}
{{/ core/modal }}