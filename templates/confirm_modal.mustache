{{!
    @template 'mod_examcheck/confirm_modal';

    Template purpose and description.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
        "userPicture": "<img src=\"https://example.org/user.jpg\" alt=\"Jane Doe\" class=\"userpicture\">",
        "userFullname": "Jane Doe",
        "scanFieldName": "User id (internal)",
        "scanValue": "6",
        "seatLabel": "A12",
        "rosterLink": "https://tbd.example.org",
        "steps": [
            {"name": "Attendance", "checked": true, "current": false},
            {"name": "ID verified", "checked": false, "current": true}
        ]
    }
}}

{{< core/modal }}
    {{$classes}} {{classes}} modal-fullscreen-sm-down {{/classes}}
    {{$title}}{{#str}} confirm_step, mod_examcheck, {{stepName}} {{/str}}{{/title}}
    {{$body}}
        {{> mod_examcheck/scan_result_modal/user_info }}
        {{> mod_examcheck/scan_result_modal/step_statuses }}
    {{/body}}
    {{$footer}}
        <button type="button" class="btn btn-secondary flex-grow-1 flex-sm-grow-0" data-action="hide">
            {{#str}} cancel {{/str}}
        </button>
        <button type="button" class="btn btn-primary flex-grow-1 flex-sm-grow-0" data-action="confirm">
            {{#str}} confirm {{/str}}
        </button>
    {{/footer}}
{{/ core/modal }}
