{{!
    @template mod_examcheck/scan_result_modal/step_statuses

    Read-only table of the matched student's check status, one column per step. The
    step currently being checked (if any) is highlighted. Mirrors the roster grid's
    check icons: a green tick for checked, an outline square for not checked.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * steps array Per-step status: { name, checked, current }.

    Example context (json):
    {
        "steps": [
            {"name": "Attendance", "checked": true, "current": false},
            {"name": "ID verified", "checked": false, "current": true},
            {"name": "Paper submitted", "checked": true, "current": false}
        ]
    }
}}
<div class="table-responsive mt-3">
    <table class="table table-sm text-center align-middle mb-0 examcheck-step-statuses">
        <caption class="visually-hidden">{{#str}} checkstatus, mod_examcheck {{/str}}</caption>
        <thead>
            <tr>
                {{#steps}}
                    <th scope="col" class="{{#current}}table-active fw-bold examcheck-currentstep{{/current}}">{{name}}</th>
                {{/steps}}
            </tr>
        </thead>
        <tbody>
            <tr>
                {{#steps}}
                    <td class="{{#current}}table-active examcheck-currentstep{{/current}}">
                        {{#checked}}
                            <i class="fa fa-check text-success" aria-hidden="true"></i>
                            <span class="visually-hidden">{{#str}} checked, mod_examcheck {{/str}}</span>
                        {{/checked}}
                        {{^checked}}
                            <i class="fa fa-square-o text-muted" aria-hidden="true"></i>
                            <span class="visually-hidden">{{#str}} notchecked, mod_examcheck {{/str}}</span>
                        {{/checked}}
                    </td>
                {{/steps}}
            </tr>
        </tbody>
    </table>
</div>
