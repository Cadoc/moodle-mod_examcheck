{{!
    @template 'mod_examcheck/confirm_modal';

    Template purpose and description.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
        "userPicture": "<img src=\"https://example.org/user.jpg\" alt=\"Jane Doe\" class=\"userpicture\">",
        "userFullname": "Jane Doe",
        "scanFieldName": "User id (internal)",
        "scanValue": "6",
        "rosterLink": "https://tbd.example.org"
    }
}}

<div class="mb-3 d-flex flex-row align-items-center">
    <div class="mr-3">{{{ userPicture }}}</div>
    <div class="d-flex flex-column">
        <div class="font-bold">{{ userFullname }}</div>
        <small class="text-muted">{{ scanFieldName }}: {{ scanValue }}</small>
        <a href="{{ rosterLink }}"><small class="text-muted link-underline">{{#str}} view_in_roster, mod_examcheck {{/str}}</small></a>
    </div>
</div>