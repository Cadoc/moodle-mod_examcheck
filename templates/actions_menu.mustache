{{!
    @template mod_examcheck/actions_menu

    "With selected students" bulk-action bar: an Export submenu plus, for users who
    may check, a Mark/Uncheck submenu per step. The select is disabled until at
    least one roster checkbox is ticked (core/checkbox-toggleall wires that up).

    Context variables required for this template:
    * cancheck - whether the viewer may record checks (controls the mark/uncheck groups)
    * exports  - array of {value, label} for the export submenu (csv/excel/pdf)
    * steps    - array of {stepid, marklabel, unmarklabel} for the per-step submenus

    Example context (json):
    {
        "cancheck": true,
        "exports": [{"value": "csv", "label": "Comma-separated values (.csv)"}],
        "steps": [{"stepid": 12, "marklabel": "Check: Attendance", "unmarklabel": "Uncheck: Attendance"}]
    }
}}
<div class="examcheck-withselected d-flex flex-wrap align-items-center gap-2 my-3">
    <label for="examcheck-bulkaction" class="col-form-label">
        {{#str}}withselectedstudents, mod_examcheck{{/str}}
    </label>
    <select id="examcheck-bulkaction" name="bulkaction"
            data-action="toggle" data-togglegroup="examcheck-roster" data-toggle="action"
            disabled>
        <option value="">{{#str}}choosedots{{/str}}</option>
        <optgroup label="{{#str}}exportas, mod_examcheck{{/str}}">
            {{#exports}}
            <option value="export:{{value}}">{{label}}</option>
            {{/exports}}
        </optgroup>
        {{#cancheck}}
        <optgroup label="{{#str}}markchecked, mod_examcheck{{/str}}">
            {{#steps}}
            <option value="mark:{{stepid}}">{{marklabel}}</option>
            {{/steps}}
        </optgroup>
        <optgroup label="{{#str}}uncheck, mod_examcheck{{/str}}">
            {{#steps}}
            <option value="unmark:{{stepid}}">{{unmarklabel}}</option>
            {{/steps}}
        </optgroup>
        {{/cancheck}}
    </select>
</div>
