{{!
    @template mod_examcheck/seats_action_bar

    Tertiary navigation for the Seats tab: a grouped selector switching between
    the seat subpages (assignment, edit, import, export). The selector partial
    ships its own change-to-navigate JS.

    Context variables required for this template:
    * seatsnavselector - the exported core/select_menu context.

    Example context (json):
    {
        "seatsnavselector": {
            "baseid": "select-menu1",
            "name": "examcheckseatsactionselect",
            "value": "https://example.org/mod/examcheck/seats.php?id=2&action=assign",
            "selectedoption": "Seat assignment",
            "options": [
                {
                    "name": "Seat assignment",
                    "value": "https://example.org/mod/examcheck/seats.php?id=2&action=assign",
                    "id": "select-menu-option1",
                    "selected": true
                }
            ]
        }
    }
}}
<div class="container-fluid tertiary-navigation">
    <div class="row">
        <div class="navitem">
            {{#seatsnavselector}}
                {{> core/tertiary_navigation_selector }}
            {{/seatsnavselector}}
        </div>
    </div>
</div>
